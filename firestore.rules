rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc().data.approved == true; }
    function admin() { return signedIn() && request.auth.token.email == 'rohit.fcg123@gmail.com' && request.auth.token.email_verified == true; }
    function codeEnabled(codeId) { return exists(/databases/$(database)/documents/scorerCodes/$(codeId)) && get(/databases/$(database)/documents/scorerCodes/$(codeId)).data.enabled == true; }
    function activeScorer() { return signedIn() && exists(/databases/$(database)/documents/scorerSessions/$(request.auth.uid)) && get(/databases/$(database)/documents/scorerSessions/$(request.auth.uid)).data.active == true && codeEnabled(get(/databases/$(database)/documents/scorerSessions/$(request.auth.uid)).data.codeId); }

    // Public users may only read published match scoreboards.
    match /matches/{matchId} {
      allow read: if resource.data.status != 'deleted';
      allow create: if admin()
        || (activeScorer()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.teamA is string
          && request.resource.data.teamB is string);
      allow update: if admin()
        || (activeScorer()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if admin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      // Admins can approve users, but users cannot assign themselves a role.
      allow create, update: if admin();
      allow delete: if admin();
    }

    match /scorerCodes/{codeId} {
      // A scorer who knows a code can fetch that single enabled code, but cannot list codes.
      allow get: if admin() || signedIn();
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    match /scorerSessions/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['displayName', 'codeId', 'active', 'createdAt'])
        && request.resource.data.active == true
        && request.resource.data.displayName is string
        && request.resource.data.codeId is string
        && codeEnabled(request.resource.data.codeId)
        && get(/databases/$(database)/documents/scorerCodes/$(request.resource.data.codeId)).data.displayName == request.resource.data.displayName;
      allow update, delete: if admin();
    }

    match /settings/{settingId} {
      allow read: if admin() || approved();
      allow write: if admin();
    }
    match /auditLogs/{logId} {
      allow read: if admin();
      allow create: if approved() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}